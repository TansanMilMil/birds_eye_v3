map_hash_bucket_size 128;

map $http_x_cloudfront_secret $cloudfront_blocked {
    default                           1;
    "${BIRDSEYE_CLOUDFRONT_SECRET}"   0;
}

map $cloudfront_blocked $cloudfront_ok {
    0       1;
    default 0;
}

map $http_cloudfront_viewer_address $cloudfront_viewer_ip {
    default                                    "";
    "~^(?<viewer_ip>[0-9A-Fa-f.:]+):[0-9]+$"   $viewer_ip;
}

# CloudFront-Viewer-Address is spoofable on direct access, so trust it only when the secret matches
map "$cloudfront_blocked:$cloudfront_viewer_ip" $client_ip {
    "~^0:(?<trusted_viewer_ip>.+)$"   $trusted_viewer_ip;
    default                           $remote_addr;
}

geo $client_ip $ioc_ip_blocked {
    default 0;
    include /etc/nginx/blocklist/ioc_ip.conf;
}

map $http_user_agent $ioc_ua_blocked {
    default 0;
    include /etc/nginx/blocklist/ioc_ua.conf;
}

server {
    listen 80 default_server;
    server_name _;

    root /var/www/html;
    index index.html;

    if ($ioc_ip_blocked) {
        return 403;
    }

    if ($ioc_ua_blocked) {
        return 403;
    }

    # Limit allowed methods
    if ($request_method !~ ^(GET|POST|PUT|DELETE|HEAD|OPTIONS)$) {
        return 405;
    }

    limit_conn conn_limit 10;

    # Apply rate limiting
    limit_req zone=api burst=20 nodelay;

    location /HealthCheck {
        return 200 'ok';
        add_header Content-Type text/plain;
        limit_except GET { deny all; }
    }

    # Scraping is triggered only by ofelia inside the go container
    location ^~ /api/news/scrape {
        return 404;
    }

    # API proxy
    location /api/ {
        if ($cloudfront_blocked) {
            return 403;
        }

        proxy_set_header X-CloudFront-Secret "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_hide_header X-Powered-By;

        proxy_pass http://go:8080/;
    }

    # Static files (SPA fallback)
    location / {
        if ($cloudfront_blocked) {
            return 403;
        }

        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        log_not_found off;
        return 404;
    }
}
